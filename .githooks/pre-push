#!/bin/sh
# Before a v* tag leaves this PC, check the build backend is up to date (tools/check-backend.py).
# Turn on once per clone: git config core.hooksPath .githooks
while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/v*)
            python "$(git rev-parse --show-toplevel)/tools/check-backend.py" || {
                echo "Push of $remote_ref stopped: update the backend first."; exit 1; }
            exit 0 ;;
    esac
done
exit 0
